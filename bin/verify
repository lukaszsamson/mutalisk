#!/usr/bin/env bash
# Run all quality gates, or one named layer: bash bin/verify [layer].

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

rm -rf tmp

ALL_LAYERS=(
  lint
  unit
  dialyzer
  golden_oracle
  golden_instrument
  integration_schema
  integration_fallback
  e2e_mut
  docs
  package
)

is_known() {
  local layer="$1"
  for l in "${ALL_LAYERS[@]}"; do
    [ "$l" = "$layer" ] && return 0
  done
  return 1
}

step() { printf '\n==> %s\n' "$1"; }

run_lint() {
  step lint
  mix format --check-formatted
  mix compile --warnings-as-errors
  mix credo --strict
}

run_unit() {
  step unit
  mix test
  bash scripts/fixture_check.sh
}

run_dialyzer() {
  step dialyzer
  mix dialyzer
}

run_golden_oracle() {
  step golden_oracle
  mix test --only golden_oracle
}

run_golden_instrument() {
  step golden_instrument
  mix test --only golden_instrument
}

run_integration_schema() {
  step integration_schema
  mix mut.test_schema
}

run_integration_fallback() {
  step integration_fallback
  mix mut.test_fallback
}

run_e2e_mut() {
  step e2e_mut
  mix mut.e2e
}

run_docs() {
  step docs
  mix docs --warnings-as-errors
}

run_package() {
  step package
  mix hex.build
}

main() {
  if [ "$#" -gt 0 ]; then
    local layer="$1"
    if ! is_known "$layer"; then
      echo "Unknown layer: $layer" >&2
      echo "Known: ${ALL_LAYERS[*]}" >&2
      exit 2
    fi
    "run_${layer}"
  else
    for layer in "${ALL_LAYERS[@]}"; do
      "run_${layer}"
    done
  fi
  printf '\nOK\n'
}

main "$@"
